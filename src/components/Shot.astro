---
// SPDX-License-Identifier: Apache-2.0
// A screenshot as WebP in the sizes it is shown at. With a dark variant, the picture follows the
// device's light or dark setting, like the rest of the page.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  /** Widths to offer; the browser picks by the space the picture gets. */
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { image, dark, alt, widths = [640, 960, 1280], sizes = "(max-width: 1168px) 100vw, 1120px", eager = false } = Astro.props;
const usable = widths.filter((w) => w <= image.width);
if (usable.length === 0) usable.push(image.width);

async function variants(source: ImageMetadata) {
  const list = [];
  for (const width of usable) {
    const result = await getImage({ src: source, width, format: "webp", quality: 82 });
    list.push(`${result.src} ${width}w`);
  }
  return list.join(", ");
}

const lightSet = await variants(image);
const darkSet = dark ? await variants(dark) : undefined;
const fallback = await getImage({ src: image, width: usable[usable.length - 1], format: "webp", quality: 82 });
const height = Math.round((image.height / image.width) * usable[usable.length - 1]);
---

<picture class={Astro.props.class}>
  {darkSet && <source media="(prefers-color-scheme: dark)" srcset={darkSet} sizes={sizes} type="image/webp" />}
  <source srcset={lightSet} sizes={sizes} type="image/webp" />
  <img
    src={fallback.src}
    width={usable[usable.length - 1]}
    height={height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : undefined}
  />
</picture>
