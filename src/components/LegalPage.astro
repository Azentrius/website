---
// SPDX-License-Identifier: Apache-2.0
import { render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";

interface Props {
  entry: CollectionEntry<"legal">;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base lang={d.lang} page={d.page} title={d.title} description={d.description}>
  <section class="legal">
    <div class="wrap">
      <p class="az-eyebrow">{d.eyebrow}</p>
      <h1>{d.h1}</h1>
      <p class="subtitle">{d.subtitle}</p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Base>
