---
// SPDX-License-Identifier: Apache-2.0
// The start page: the brand, the projects, the package repository in one minute, the values.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ToolCard from "./ToolCard.astro";
import CopyBlock from "./CopyBlock.astro";
import ProductName from "./ProductName.astro";
import Shot from "./Shot.astro";
import updates from "../assets/screenshots/cockpit-image-update-monitor/updates.png";
import updatesDark from "../assets/screenshots/cockpit-image-update-monitor/updates-dark.png";
import updatesMobile from "../assets/screenshots/cockpit-image-update-monitor/mobile.png";
import updatesMobileDark from "../assets/screenshots/cockpit-image-update-monitor/mobile-dark.png";
import { TOOLS } from "../data/tools";
import { SITE } from "../data/routes.mjs";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const entries = await getCollection("tools", (e) => e.data.lang === lang);
const bySlug = Object.fromEntries(entries.map((e) => [e.data.slug, e]));
const previewTool = TOOLS.find((tool) => tool.slug === "cockpit-image-update-monitor")!;

const text = {
  en: {
    title: "Azentrius – open-source tools for self-hosters",
    description:
      "Open-source tools for your infrastructure and devices: Cockpit add-ons for cron, updates and security, a desk display for Claude Code and Codex, and more.",
    eyebrow: "Digital sovereignty",
    h1: "Software you own",
    lead: "Open-source tools for your own infrastructure and devices: add-ons for Cockpit, a desk display for Claude Code and Codex, an Android voice app, a self-hosted tool for passing on Instagram and Facebook posts, and a theme for Home Assistant. Local control, transparent dependencies: each project page says what it needs and what it talks to.",
    toProjects: "View projects",
    toPackages: "Set up the package repository",
    facts: [
      ["Apache-2.0", "Open source, every project"],
      ["EU", "Our servers and analytics"],
      ["Transparent", "Dependencies named per project"],
    ],
    previewTitle: "Keep container updates in sight.",
    previewText: "See which version is running and which is available. Update your containers directly in Cockpit, with a rollback image and dumps for supported databases.",
    previewLink: "View Image Update Monitor",
    previewAlt: "Image Update Monitor in Cockpit: an excerpt of the container overview with installed and available versions, update status and update actions.",
    projectsEyebrow: "Projects",
    projectsTitle: "Current projects",
    allProjects: "All projects compared",
    installEyebrow: "Package repository",
    installTitle: "Installed in a minute",
    installText:
      "Set up the Azentrius package repository once. Cockpit then lists the add-ons under Applications, ready to install, and your system's updates keep them current. Every package was built by the release workflow of its own repository; the repository checks that before it takes one.",
    debian: "Debian and Ubuntu",
    fedora: "Fedora and RHEL",
    installMore: "Signing key, fingerprint and how packages are checked",
    valuesEyebrow: "What we stand for",
    valuesTitle: "Why Azentrius",
    values: [
      ["Privacy first", "Privacy is not a feature, it is the foundation of every decision."],
      ["Control", "The tools run on your servers and devices. Where a project needs an outside service, its page names it."],
      ["European roots", "Our website, package repository and analytics run on our own servers in the EU."],
      ["Openness", "Open architectures, auditable code, no black boxes."],
    ],
    by: "Azentrius is a project by",
  },
  de: {
    title: "Azentrius – Open-Source-Werkzeuge für Self-Hoster",
    description:
      "Open-Source-Werkzeuge für eigene Server und Geräte: Cockpit-Add-ons für Cron, Updates und Sicherheit, ein Tischdisplay für Claude Code und Codex und mehr.",
    eyebrow: "Digitale Souveränität",
    h1: "Software, die dir gehört",
    lead: "Open-Source-Werkzeuge für deine eigene Infrastruktur und deine Geräte: Erweiterungen für Cockpit, ein Tischdisplay für Claude Code und Codex, eine Sprach-App für Android, ein selbst gehostetes Werkzeug zum Weitergeben von Instagram- und Facebook-Beiträgen und ein Theme für Home Assistant. Kontrolle bei dir, Abhängigkeiten offen benannt: Jede Projektseite sagt, was ein Projekt braucht und womit es spricht.",
    toProjects: "Projekte ansehen",
    toPackages: "Paketquelle einrichten",
    facts: [
      ["Apache-2.0", "Open Source, jedes Projekt"],
      ["EU", "Eigene Server und Statistik"],
      ["Transparent", "Abhängigkeiten je Projekt benannt"],
    ],
    previewTitle: "Container-Updates im Blick.",
    previewText: "Sieh, welche Version läuft und welche verfügbar ist. Aktualisiere deine Container direkt in Cockpit – mit Rollback-Image und Dumps für unterstützte Datenbanken.",
    previewLink: "Image Update Monitor ansehen",
    previewAlt: "Image Update Monitor in Cockpit: Ausschnitt der Containerübersicht mit installierten und verfügbaren Versionen, Update-Status und Aktionen zum Aktualisieren.",
    projectsEyebrow: "Projekte",
    projectsTitle: "Aktuelle Projekte",
    allProjects: "Alle Projekte im Vergleich",
    installEyebrow: "Paketquelle",
    installTitle: "In einer Minute installiert",
    installText:
      "Richte die Azentrius-Paketquelle einmal ein. Danach zeigt Cockpit die Erweiterungen unter Anwendungen zur Installation an, und die Updates deines Systems halten sie aktuell. Jedes Paket hat der Release-Workflow seines eigenen Repositorys gebaut; die Paketquelle prüft das, bevor sie es aufnimmt.",
    debian: "Debian und Ubuntu",
    fedora: "Fedora und RHEL",
    installMore: "Signaturschlüssel, Fingerabdruck und wie Pakete geprüft werden",
    valuesEyebrow: "Wofür wir stehen",
    valuesTitle: "Warum Azentrius",
    values: [
      ["Datenschutz zuerst", "Datenschutz ist kein Feature, sondern die Grundlage jeder Entscheidung."],
      ["Kontrolle", "Die Werkzeuge laufen auf deinen Servern und Geräten. Braucht ein Projekt einen fremden Dienst, nennt seine Seite ihn."],
      ["Europäische Wurzeln", "Website, Paketquelle und Statistik laufen auf eigenen Servern in der EU."],
      ["Offenheit", "Offene Architekturen, prüfbarer Code, keine Blackboxes."],
    ],
    by: "Azentrius ist ein Projekt von",
  },
}[lang];

const debian = `curl -fsSLO https://packages.azentrius.com/azentrius-repository.deb
sudo apt install ./azentrius-repository.deb
sudo apt update`;
const fedora = `sudo rpm --import https://packages.azentrius.com/azentrius.asc
sudo dnf install https://packages.azentrius.com/azentrius-repository.rpm`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Azentrius",
    url: SITE,
    logo: new URL("/favicon.svg", SITE).href,
    email: "support@azentrius.com",
    founder: { "@type": "Person", name: "Stefan Popp", url: "https://stefanpopp.com/" },
    sameAs: ["https://github.com/Azentrius"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Azentrius",
    url: SITE,
    inLanguage: ["en", "de"],
  },
];
const prefix = lang === "en" ? "" : "/de";
---

<Base lang={lang} page="home" title={text.title} description={text.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <p class="az-eyebrow">{text.eyebrow}</p>
      <h1 class="hero-title">{text.h1}<span class="dot">.</span></h1>
      <p class="lead">{text.lead}</p>
      <div class="actions">
        <a class="az-btn az-btn--primary az-btn--lg" href={`${prefix}/projects/`}>{text.toProjects}</a>
        <a class="az-btn az-btn--secondary az-btn--lg" href="#install">{text.toPackages}</a>
      </div>
      <dl class="facts">
        {
          text.facts.map(([value, label]) => (
            <div>
              <dt class="fact__value">{value}</dt>
              <dd class="fact__label">{label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="product-preview" aria-labelledby="update-preview-title">
    <div class="wrap">
      <figure class="product-preview__figure">
        <Shot
          image={updates}
          dark={updatesDark}
          mobile={{ image: updatesMobile, dark: updatesMobileDark }}
          widths={[390, 640, 960, 1280, 1440]}
          sizes="(max-width: 430px) calc(100vw - 40px), (max-width: 760px) 390px, (max-width: 1168px) calc(100vw - 48px), 1120px"
          alt={text.previewAlt}
          class="product-preview__shot"
        />
        <figcaption class="product-preview__caption">
          <div>
            <p class="product-preview__name"><ProductName name={previewTool.name} /></p>
            <h2 class="section-title" id="update-preview-title">{text.previewTitle}</h2>
          </div>
          <div>
            <p>{text.previewText}</p>
            <p class="more-link">
              <a href={`${prefix}/${previewTool.slug}/`}>{text.previewLink} <span aria-hidden="true">→</span></a>
            </p>
          </div>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="az-eyebrow">{text.projectsEyebrow}</p>
      <h2 class="section-title">{text.projectsTitle}</h2>
      <div class="card-grid">
        {
          TOOLS.map((tool) => (
            <ToolCard
              tool={tool}
              lang={lang}
              summary={bySlug[tool.slug].data.summary}
              platforms={bySlug[tool.slug].data.platforms}
            />
          ))
        }
      </div>
      <p class="more-link"><a href={`${prefix}/projects/`}>{text.allProjects} →</a></p>
    </div>
  </section>

  <section class="section section--alt" id="install">
    <div class="wrap split split--wide">
      <div>
        <p class="az-eyebrow">{text.installEyebrow}</p>
        <h2 class="section-title">{text.installTitle}</h2>
      </div>
      <div class="prose-plain">
        <p>{text.installText}</p>
        <CopyBlock code={debian} lang={lang} name="repository-apt" label={text.debian} />
        <CopyBlock code={fedora} lang={lang} name="repository-dnf" label={text.fedora} />
        <p class="more-link"><a href="https://packages.azentrius.com/">{text.installMore} →</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="az-eyebrow">{text.valuesEyebrow}</p>
      <h2 class="section-title">{text.valuesTitle}</h2>
      <div class="values">
        {
          text.values.map(([title, body]) => (
            <div class="value">
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          ))
        }
      </div>
      <p class="sender">{text.by} <a href="https://stefanpopp.com/">Stefan Popp</a>.</p>
    </div>
  </section>
</Base>
